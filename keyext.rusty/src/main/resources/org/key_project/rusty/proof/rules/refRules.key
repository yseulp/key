\sorts {
    \generic M;
}

\rules {
    applyElementariesOnDerefM {
        \schemaVar \update u;
        \schemaVar \term MRef<[M]> mr;
        \schemaVar \term any result;

        \find({u}derefM<[M]>(mr))
        \varcond(\applyElementariesOnDerefM(u, mr, result))
        \replacewith(result)
        \heuristics(update_apply)
    };

    applyArrPlaceMutUpdOnDerefM {
        \schemaVar \term int N, idx;
        \schemaVar \term MRef<[Array<[M, const N]>]> mr;
        \schemaVar \term M t;
        \schemaVar \skolemTerm Array<[M, const N]> sk;

        \find({arrPlace<[M, const N]>(mr, idx) *-> t}derefM<[Array<[M, const N]>]>(mr))
        \replacewith(arr_set<[M, const N]>(sk, idx, t))
        \heuristics(update_apply)
    };
}
